  "settings": {
    "openAnimation": 0, "spaceSwitchAnimation": 1, "equalizerAnimation": 0, "notchStyle": 1,
    "notchOpenTrigger": 0, "showBesideNotch": true, "showTrackPeek": true, "showShuffleRepeat": true,
